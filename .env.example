# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Read only by the server (npm run dev / npm run serve), never sent to the browser.
# The Product Assistant uses no AI service and needs no API key.

# --- Enquiries backend (every website form, and the /admin/enquiries dashboard) ---
# Required. The server refuses to start in production without these.
# MongoDB Atlas: Database > Connect > Drivers. Use a database user with
# readWrite on this database only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chakravue?retryWrites=true&w=majority
# At least 32 random characters; signs admin session cookies.
# Make one with: openssl rand -base64 48
SESSION_SECRET=
# Optional: other origins allowed to send forms (the site's own origin always
# is), comma-separated, https only in production. Example:
# ALLOWED_ORIGINS=https://www.chakravue.ai,https://chakravue.ai
# Optional: admin session length in hours (default 8, at most 24).
# SESSION_HOURS=8
# Optional: form submissions per visitor per 15 minutes (default 8).
# ENQUIRY_RATE_LIMIT=8
# Set to production on the live server (secure cookies, HSTS, startup checks).
# NODE_ENV=production

# Only for creating the first admin (npm run admin:create); remove the
# password from the environment straight after.
# ADMIN_SEED_NAME=
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

# --- Product Assistant ---
# Required for the /admin upload page (it is switched off without a password).
# Make the hash with: npm run admin:password -- "your password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# For local development only, a plain password works instead of the hash:
# ADMIN_PASSWORD=

# Optional: largest PDF the admin page accepts, in MB (default 10).
# PDF_MAX_MB=10

# Optional: where the processed document is kept (default ./data). Never
# point this inside dist/ or public/.
# DATA_DIR=./data

# Optional search tuning (README, "Product Assistant").
# CHAT_MIN_SCORE=0.3
# CHAT_MIN_SENTENCE_SCORE=0.25
# CHAT_MAX_PASSAGES=4
# CHAT_MAX_SENTENCES=4
# CHAT_PASSAGE_WORDS=80
# CHAT_PASSAGE_MAX_WORDS=160

# Optional: questions each visitor may send (defaults 20 a minute, 300 an hour).
# CHAT_RATE_PER_MINUTE=20
# CHAT_RATE_PER_HOUR=300

# Optional: set to 1 only behind a reverse proxy you control, so rate limits
# use the visitor's address from X-Forwarded-For.
# TRUST_PROXY=0

# Optional (npm run serve): port and interface.
# PORT=4175
# HOST=0.0.0.0

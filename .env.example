# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Read only by the server (npm run dev / npm run serve), never sent to the browser.

# Required: an Anthropic API key from https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional: the Claude model the assistant uses (default claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: messages each visitor may send (defaults 8 a minute, 60 an hour).
# CHAT_RATE_PER_MINUTE=8
# CHAT_RATE_PER_HOUR=60

# Optional: set to 1 only behind a reverse proxy you control, so rate limits
# use the visitor's address from X-Forwarded-For.
# TRUST_PROXY=0

# Optional (npm run serve): port and interface.
# PORT=4175
# HOST=0.0.0.0
